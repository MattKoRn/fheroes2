# Special targets to cleanup operation of make.

# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	cd /d C:\Users\BOYOLA~1\DOWNLO~1\FHEROE~1\FHEROE~1\BUILD_~1 && $(CMAKE_COMMAND) -P "C:\Users\Boyo Laptop\Downloads\fheroes2-master\fheroes2-master\build_test\CMakeFiles\VerifyGlobs.cmake"
	cd /d C:\Users\BOYOLA~1\DOWNLO~1\FHEROE~1\FHEROE~1\BUILD_~1 && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles\Makefile.cmake 0
.PHONY : cmake_check_build_system

